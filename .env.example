# Server-only live traffic credential. Never commit the real .env file.
TOMTOM_API_KEY=replace_with_your_tomtom_api_key

# Firebase service account key (required on Render / deployed environments).
# Go to Firebase Console > Project Settings > Service Accounts > Generate New
# Private Key, then paste the ENTIRE JSON content here as a single line.
# Not needed for local dev if you have gcloud ADC configured.
# WARNING: Do NOT paste the actual key here — add it as an env var on Render.
FIREBASE_SERVICE_ACCOUNT_KEY=
